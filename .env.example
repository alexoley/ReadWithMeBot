# Скопируйте в .env:  cp .env.example .env  и впишите свои значения

# ===== ОБЯЗАТЕЛЬНО =====
# Токен от @BotFather
BOT_TOKEN=
# Username бота без @ (например ReadWithMe_bot)
BOT_USERNAME=
# Ваш Telegram user id (числом; узнать можно у @userinfobot)
BOT_CREATORID=

# ===== Хранилище книг =====
# local = книги лежат в docker-томе (Google Drive не нужен)
# Чтобы использовать Google Drive — оставьте значение пустым: SPRING_PROFILES_ACTIVE=
SPRING_PROFILES_ACTIVE=local

# ===== Только для Google Drive (если профиль пустой) =====
# JSON ключа service account ОДНОЙ строкой в одинарных кавычках
GOOGLE_SERVICE_ACCOUNT_CREDENTIALS=
# ID папки на Drive, расшаренной на email service account
FILE_PARENT_FOLDER_ID=

# ===== Необязательно =====
MONGO_USER=user
MONGO_PASSWORD=password
TZ=Europe/Kyiv
